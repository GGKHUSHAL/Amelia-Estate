<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteCond %{HTTPS} !=on [OR]
    RewriteCond %{HTTP_HOST} ^www\.ameliaestate\.realtynivesh\.com$ [NC]
    RewriteRule ^ https://ameliaestate.realtynivesh.com%{REQUEST_URI} [R=301,L]
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(html?|xml|txt)$">
        Header set X-Robots-Tag "index, follow"
    </FilesMatch>
</IfModule>
